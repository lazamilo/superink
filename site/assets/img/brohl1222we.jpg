5,0.6);} #si-topbar .si-inner{max-width:1200px;margin:0 auto;padding:0 24px;display:flex;justify-content:space-between;align-items:center;} #si-topbar a{color:rgba(255,255,255,0.6);text-decoration:none;} #si-topbar a:hover{color:#fff;} #si-topbar .si-topbar-r{display:flex;align-items:center;gap:16px;} #si-topbar .si-topbar-r a{display:flex;align-items:center;gap:5px;padding:2px 8px;border-radius:4px;transition:background 0.15s;} #si-topbar .si-topbar-r a:hover{background:rgba(255,255,255,0.08);} #si-header{background:#fff;border-bottom:1px solid #EBEBEB;padding:14px 0;font-family:'DM Sans',sans-serif;} #si-header .si-inner{max-width:1200px;margin:0 auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;gap:20px;} #si-logo-wrap{display:flex;align-items:center;gap:11px;text-decoration:none;flex-shrink:0;} #si-logo-mark{width:44px;height:44px;background:#C0392B;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:22px;font-weight:700;font-family:'DM Sans',sans-serif;flex-shrink:0;} #si-logo-name{font-size:22px;font-weight:700;color:#111;letter-spacing:-0.5px;line-height:1.1;} #si-logo-sub{font-size:10px;color:#BBB;letter-spacing:1.8px;text-transform:uppercase;font-weight:400;} #si-header #search{margin:0;flex:1;max-width:500px;} #si-header #search .input-group{border:1.5px solid #E0E0E0;border-radius:9px;overflow:hidden;background:#F5F5F7;transition:border-color 0.2s;} #si-header #search .input-group:focus-within{border-color:#C0392B;background:#fff;} #si-header #search .form-control{background:transparent;border:none;box-shadow:none;padding:10px 16px;font-family:'DM Sans',sans-serif;font-size:13px;height:42px;} #si-header #search .btn{background:#C0392B;border:none;border-radius:0;padding:10px 22px;color:#fff;font-size:14px;height:42px;} #si-header #search .btn:hover{background:#922B21;} #si-header #cart{margin:0;} #si-header #cart>.btn{background:#111!important;background-image:none!important;color:#fff!important;border:none!important;border-radius:9px!important;padding:10px 20px!important;font-family:'DM Sans',sans-serif!important;font-size:13px!important;font-weight:500!important;text-shadow:none!important;} #si-header #cart>.btn:hover{background:#333!important;} #si-account-btn{font-size:13px;color:#666;text-decoration:none;display:flex;align-items:center;gap:6px;white-space:nowrap;flex-shrink:0;font-family:'DM Sans',sans-serif;} #si-account-btn:hover{color:#C0392B;} #si-promo{background:#fff;border-bottom:1px solid #F0F0F0;font-family:'DM Sans',sans-serif;} #si-promo .si-promo-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);} .si-promo-item{padding:14px 20px;display:flex;align-items:center;gap:11px;border-right:1px solid #F0F0F0;} .si-promo-item:last-child{border-right:none;} .si-promo-ico{width:34px;height:34px;border-radius:8px;background:#FDEDEC;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;} .si-promo-lbl{font-size:13px;font-weight:600;color:#111;} .si-promo-sub{font-size:11px;color:#BBB;margin-top:1px;} #menu{font-family:'DM Sans',sans-serif!important;} </style> </head> <body> <!-- TOP BAR --> <div id="si-topbar"> <div class="si-inner"> <span><i class="fa fa-truck" style="margin-right:5px;color:#C0392B;"></i> Brezplačna dostava nad 50€ &nbsp;|&nbsp; <i class="fa fa-bolt" style="margin-right:5px;color:#C0392B;"></i> Odpremimo isti dan za naročila do 14:00</span> <div class="si-topbar-r"> <a href="https://www.superink.si/index.php?route=information/contact"><i class="fa fa-phone"></i> 0590 95 484</a> <a href="https://www.superink.si/index.php?route=account/login"><i class="fa fa-sign-in"></i> Prijava</a> <a href="https://www.superink.si/index.php?route=account/register"><i class="fa fa-user-plus"></i> Registracija</a> <a href="https://www.superink.si/index.php?route=account/wishlist" id="wishlist-total"><i class="fa fa-heart"></i></a> </div> </div> </div> <!-- HEADER --> <div id